# Tell GitHub Linguist to treat platform-specific Flutter code as vendored
# This ensures the repo is classified as Dart, not C++/Swift/Kotlin

# Mark build outputs as generated
build/** linguist-generated
.dart_tool/** linguist-generated

# Mark Android platform code as vendored
android/** linguist-vendored
*.gradle linguist-vendored
*.gradle.kts linguist-vendored

# Mark iOS platform code as vendored
ios/** linguist-vendored
*.swift linguist-vendored
*.m linguist-vendored

# Mark Windows/Linux/macOS platform code as vendored
windows/** linguist-vendored
linux/** linguist-vendored
macos/** linguist-vendored
*.cc linguist-vendored
*.cpp linguist-vendored

# Explicitly include Dart files
*.dart linguist-language=Dart
